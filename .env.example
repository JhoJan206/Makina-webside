# Copia este archivo como .env y completa los valores.

# Cadena de conexión de Supabase -> Project Settings -> Database -> Connection string
# Usa el "Transaction pooler" (puerto 6543), que es el indicado para Vercel.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Secreto para firmar la sesión (JWT). Genera uno largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Opcionales
# PORT=3000
# SESSION_DAYS=7
# DB_POOL_MAX=3
